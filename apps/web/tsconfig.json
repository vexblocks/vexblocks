{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"jsx": "preserve",
		"module": "esnext",
		"moduleResolution": "bundler",
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./*"],
			"@/convex/*": ["../../packages/backend/convex/*"],
			"@/emails/*": ["../../packages/backend/emails/*"],
			"@repo/*": ["../../packages/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
