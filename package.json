{
	"name": "vexblocks-monorepo",
	"version": "0.2.0",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"generate-types": "pnpm --filter @repo/type-generator generate",
		"dev": "pnpm generate-types && turbo run dev",
		"dev:web": "turbo run dev --filter=web",
		"dev:admin": "turbo run dev --filter=admin",
		"dev:cms": "turbo run dev --filter=vexblocks-cms",
		"build": "turbo run build",
		"build:web": "turbo run build --filter=web",
		"build:admin": "turbo run build --filter=admin",
		"build:cli": "pnpm --filter @vexblocks/cli build",
		"start": "turbo run start --parallel",
		"start:web": "turbo run start --filter=web",
		"start:admin": "turbo run start --filter=admin",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"typecheck": "turbo run typecheck",
		"cli:dev": "pnpm --filter @vexblocks/cli dev",
		"release:cli": "pnpm build:cli && pnpm --filter @vexblocks/cli publish"
	},
	"devDependencies": {
		"oxfmt": "^0.46.0",
		"oxlint": "^1.61.0",
		"turbo": "^2.9.5"
	}
}
