{
	"name": "@vexblocks/cli",
	"version": "2.2.1",
	"description": "CLI for adding VexBlocks Headless CMS to your Turborepo project",
	"keywords": [
		"cms",
		"headless-cms",
		"convex",
		"turborepo",
		"nextjs",
		"cli"
	],
	"homepage": "https://github.com/vexblocks/vexblocks#readme",
	"bugs": {
		"url": "https://github.com/vexblocks/vexblocks/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vexblocks/vexblocks.git"
	},
	"license": "MIT",
	"author": "VexBlocks",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"vexblocks": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"dev": "tsup src/index.ts --format esm --dts --watch",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.4.2",
		"commander": "^14.0.3",
		"diff": "^9.0.0",
		"fs-extra": "^11.3.5",
		"ora": "^9.4.0",
		"picocolors": "^1.1.1",
		"tar": "^7.5.15"
	},
	"devDependencies": {
		"@types/diff": "^8.0.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.6.2",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
