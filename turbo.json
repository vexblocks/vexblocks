{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"CONVEX_DEPLOYMENT",
		"NEXT_PUBLIC_CONVEX_URL",
		"NEXT_PUBLIC_CONVEX_SITE_URL",
		"FRONT_SITE_URL",
		"CLOUDFLARE_ACCOUNT_ID",
		"CLOUDFLARE_SECRET_TOKEN",
		"RESEND_API_KEY",
		"SITE_URL",
		"ENABLE_EXPERIMENTAL_COREPACK"
	],
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "dist/**"],
			"cache": true,
			"persistent": false
		},
		"@apps/web#build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**"],
			"cache": true,
			"env": [
				"CONVEX_DEPLOYMENT",
				"NEXT_PUBLIC_CONVEX_URL",
				"NEXT_PUBLIC_CONVEX_SITE_URL",
				"FRONT_SITE_URL",
				"CLOUDFLARE_ACCOUNT_ID",
				"CLOUDFLARE_SECRET_TOKEN",
				"ENABLE_EXPERIMENTAL_COREPACK"
			]
		},

		"start": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"outputs": []
		},
		"typecheck": {
			"outputs": []
		}
	}
}
